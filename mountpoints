storage_account = "1stprojectstorageaccount"
container = "healthcare"

tenant_id = ""
client_id = ""
client_secret = ""

spark.conf.set(
    f"fs.azure.account.auth.type.1stprojectstorageaccount.dfs.core.windows.net",
    "OAuth"
)

spark.conf.set(
    f"fs.azure.account.oauth.provider.type.1stprojectstorageaccount.dfs.core.windows.net",
    "org.apache.hadoop.fs.azurebfs.oauth2.ClientCredsTokenProvider"
)

spark.conf.set(
    f"fs.azure.account.oauth2.client.id.1stprojectstorageaccount.dfs.core.windows.net",
    client_id
)

spark.conf.set(
    f"fs.azure.account.oauth2.client.secret.1stprojectstorageaccount.dfs.core.windows.net",
    client_secret
)

spark.conf.set(
    f"fs.azure.account.oauth2.client.endpoint.1stprojectstorageaccount.dfs.core.windows.net",
    f"https://login.microsoftonline.com/{tenant_id}/oauth2/token"
)
